{
	"name": "view-ignored-vscode",
	"displayName": "View ignored",
	"version": "0.0.1",
	"description": "Retrieve list of files ignored/included by Git, NPM, Yarn, JSR, VSCE or other tools.",
	"categories": [
		"Other",
		"SCM Providers"
	],
	"license": "MIT",
	"author": "Mopsgamer",
	"repository": {
		"type": "git",
		"url": "git://github.com/Mopsgamer/view-ignored-vscode.git"
	},
	"publisher": "Mopsgamer",
	"type": "module",
	"main": "./dist/extension.cjs",
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && npm run fmt && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "bun --bun node_modules/typescript/bin/tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"vsix": "vsce package",
		"check-types": "tsc --noEmit",
		"check": "bun check-types",
		"lint": "oxlint",
		"fmt": "oxfmt"
	},
	"dependencies": {
		"ms": "^2.1.3",
		"simple-icons": "^16.27.1",
		"view-ignored": "^0.11.1"
	},
	"devDependencies": {
		"@types/ms": "latest",
		"@types/node": "^20.19.43",
		"@types/vscode": "^1.125.0",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "latest",
		"npm-run-all": "latest",
		"oxfmt": "latest",
		"oxlint": "latest",
		"typescript": "^6.0.3",
		"typescript7": "npm:typescript@^7.0.2"
	},
	"contributes": {
		"icons": {
			"view-ignored-npm": {
				"description": "Deno icon provided by View ignored",
				"default": {
					"fontCharacter": "\\f1eb",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-yarn": {
				"description": "Deno icon provided by View ignored",
				"default": {
					"fontCharacter": "\\f72f",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-git": {
				"description": "Deno icon provided by View ignored",
				"default": {
					"fontCharacter": "\\ee52",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-bun": {
				"description": "Deno icon provided by View ignored",
				"default": {
					"fontCharacter": "\\eba7",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-deno": {
				"description": "Deno icon provided by View ignored",
				"default": {
					"fontCharacter": "\\ece2",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-jsr": {
				"description": "Deno icon provided by View ignored",
				"default": {
					"fontCharacter": "\\efe1",
					"fontPath": "./SimpleIcons.woff"
				}
			}
		},
		"commands": [
			{
				"title": "Disable decorations",
				"command": "viewIgnored.scan.clear",
				"category": "View ignored",
				"enablement": "viewIgnored.isReady && viewIgnored.isScanning",
				"icon": "$(search-stop)"
			},
			{
				"title": "Scan decorations",
				"command": "viewIgnored.scan",
				"category": "View ignored",
				"enablement": "viewIgnored.isReady && !viewIgnored.isScanning",
				"icon": "$(source-control-view-icon)"
			},
			{
				"title": "Explain ignoring reasons",
				"command": "viewIgnored.explain",
				"category": "View ignored",
				"enablement": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot",
				"icon": "$(question)"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "viewIgnored.explain",
					"group": "explainignoring",
					"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot"
				}
			],
			"view/title": [
				{
					"command": "viewIgnored.scan.clear",
					"when": "view == workbench.explorer.fileView && viewIgnored.isReady && viewIgnored.isScanning",
					"group": "navigation"
				},
				{
					"command": "viewIgnored.scan",
					"when": "view == workbench.explorer.fileView && viewIgnored.isReady && !viewIgnored.isScanning",
					"group": "navigation"
				}
			]
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"engines": {
		"vscode": "^1.125.0"
	}
}
